<% layout("/layouts/boilerplate") %>

<style>
  body {
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #2c2c2c;
    line-height: 1.6;
  }

  h3, h4, h5 {
    font-weight: 600;
    color: #222;
  }

  h3 { font-size: 1.75rem; margin-bottom: 1rem; }
  h4 { font-size: 1.4rem; margin: 1.5rem 0 1rem; }
  h5 { font-size: 1.1rem; }

  .card .card-text {
    font-size: 0.95rem;
    color: #444;
  }

  /* Special style for description */
  .listing-description {
    font-size: 1.05rem;
    font-weight: 400;
    color: #333;
    line-height: 1.7;
    margin-bottom: 1rem;
    font-family: "Georgia", "Times New Roman", serif;
  }

  .show-img {
    max-height: 420px;
    object-fit: cover;
    border-radius: 8px;
  }

  .btn {
    font-size: 0.9rem;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 6px;
  }

  label {
    font-weight: 500;
    font-size: 0.9rem;
  }

  textarea, input, select {
    font-size: 0.9rem;
  }

  .starability-slot label {
    font-size: 0.85rem;
  }

  .starability-result {
    font-size: 0.95rem;
    color: #f6c85f;
  }

  .invalid-feedback {
    font-size: 0.8rem;
  }
</style>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">
    <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/placeholder.png' %>"
         class="card-img-top show-img" alt="listing_image">
    <div class="card-body">
      <p class="card-text">
        Owned by <b><i><%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown" %></i></b>
      </p>

      <!-- Description with better font -->
      <p class="card-text listing-description"><%= listing.description || "No description available" %></p>

      <p class="card-text"> &#8377; <%= Number.isFinite(listing.price) ? listing.price.toLocaleString("en-IN") : "Price not available" %> /night</p>
      <p class="card-text"><%= listing.location || "Location not available" %></p>
      <p class="card-text"><%= listing.country || "Country not available" %></p>
    </div>
  </div>

  <br />

  <% 
    if (currUser && listing.owner && listing.owner._id && String(listing.owner._id) === String(currUser._id)) { 
  %>
    <div class="btns">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark cols-1 offset-3 edit-btn">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display:inline">
        <button class="btn btn-dark offset-5">Delete</button>
      </form>
    </div>
  <% } %>

  <div class="col-8 offset-3 mb-3">
    <hr />
    <% if (currUser) { %>
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">Please enter a comment for review</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>
      <hr />
    <% } %>

    <p><b>All Reviews</b></p>

    <div class="row">
      <% if (listing.reviews && listing.reviews.length) { %>
        <% for (let review of listing.reviews) { %>
          <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
              <h5 class="card-title"><%= review.author && review.author.username ? review.author.username : "Anonymous" %></h5>
              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>
            </div>

            <% if (currUser && review.author && String(review.author._id) === String(currUser._id)) { %>
              <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <p class="ms-3">No reviews yet.</p>
      <% } %>
    </div>
  </div>
</div>
